# Copy to .env and fill in (never commit .env — it is git-ignored).
# Only needed items: a logged-in Chrome profile + project id.
# Everything else has working defaults.

# Chrome profile that is signed in to flow.google.com (gets created on first
# visible-login; the engine reuses it off-screen afterwards).
FLOW_PROFILE=

# CDP port for the engine (change only if 9333 is taken)
FLOW_PORT=9333

# Override Chrome path if auto-detect fails
FLOW_CHROME=

# Output folder for images
FLOW_OUT=

# Defaults (also settable via CLI flags / REPL commands)
FLOW_PROJECT=
FLOW_MODEL=NARWHAL

# Auto-login fallback (used only if the session dies; manual login preferred)
FLOW_EMAIL=
FLOW_PASSWORD=

# Timeouts / retries
FLOW_BOOT_TIMEOUT=90
FLOW_GEN_TIMEOUT=120
FLOW_HTTP_RETRIES=3

# --- Google-facing throttle (account protection; worker honors these) ---
FLOW_MIN_SUBMIT_INTERVAL=45
FLOW_MAX_GENERATE_PER_DAY=200
FLOW_MAX_UPSCALE_PER_DAY=100

# --- API service (flow_server.py) ---
ROLE=all                       # all = local engine+API | api = queue only (Render)
API_KEYS=                      # e.g. cms1:secret1,cms2:secret2 (empty = open)
RATE_POST_PER_MIN=20
RATE_GET_PER_MIN=120

# --- worker (worker.py, runs where Chrome + profile live) ---
API_BASE=http://127.0.0.1:8787
API_KEY=
WORKER_NAME=home-pc

# --- durable file storage (optional S3-compatible, e.g. Cloudflare R2) ---
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
S3_PUBLIC_BASE=
