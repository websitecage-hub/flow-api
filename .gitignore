# Credentials & session data — never commit
sessions/
*.cookies.json
*.token.json
.env
auth_token.json
creds.json

# Machine-local runtime data — never commit
profile-copy/
profile-*            # any browser-profile dir (holds live session cookies)
outputs/
logs/
reports/
recon/
flow.log
srv.live.log
srv.*.log
status.md
*.tgz
profile.tgz

# Python
__pycache__/
*.pyc
.venv/
.venv-*/
venv/

# Outputs
*.mp4
*.jpg
*.png
*.webp
*.error.txt