# Fully self-hosted Flow API on Render (no local PC, no local browser).
#
# The browser engine runs INSIDE this container, making the API self-contained.
# Google Flow gates writes behind reCAPTCHA Enterprise, so a real browser is
# required — there is no pure-requests generation path.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROLE=all \
    FLOW_PROFILE=/data/profile \
    FLOW_OUT=/data/outputs

WORKDIR /app

# Slim Python deps first (cached layer), then install Chromium + every
# system library Playwright needs. Browser lands in /root/.cache/ms-playwright.
COPY requirements.docker.txt .
RUN pip install --no-cache-dir -r requirements.docker.txt \
    && playwright install --with-deps chromium

COPY flow_api.py flow_server.py flow_store.py worker.py gen.py menu.py flow.py ./
COPY start.sh ./

# /data is the Render Disk mount (profile + images survive redeploys).
RUN chmod +x start.sh && mkdir -p /data/profile /data/outputs /data/sessions /data/logs

EXPOSE 8787
CMD ["./start.sh"]
